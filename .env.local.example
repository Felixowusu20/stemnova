# =============================================================================
# STEMNova Foundation — environment template
# Copy to .env.local and fill in real values:
#   cp .env.local.example .env.local
#
# The app accepts both the names below and the alternate names noted in comments
# (matching older .env.local files).
# =============================================================================

# -----------------------------------------------------------------------------
# App / site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Alternate: NEXT_PUBLIC_APP_URL=

NODE_ENV=development
APP_SECRET=

# -----------------------------------------------------------------------------
# Database (admin CMS)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# -----------------------------------------------------------------------------
# Admin authentication (Auth.js / NextAuth)
# -----------------------------------------------------------------------------
# Production: set AUTH_URL to your live https:// domain
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Required in production (AUTH_SECRET preferred; NEXTAUTH_SECRET also works)
AUTH_SECRET=
NEXTAUTH_SECRET=
# Alternates also accepted: JWT_SECRET=  ADMIN_JWT_SECRET=  APP_SECRET=

# Initial admin bootstrap for `npm run db:seed` (must be run against production DB too)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Alternates: ADMIN_SEED_EMAIL=  ADMIN_SEED_PASSWORD=

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend
EMAIL_FROM="STEMNova Foundation <noreply@stemnovafoundation.org>"
EMAIL_TO=info@stemnovafoundation.org
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
NEXT_PUBLIC_PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=GHS

# -----------------------------------------------------------------------------
# Media / uploads (Cloudinary)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Alternates also accepted:
# CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME
# CLOUDINARY_NAME=
# CLOUDINARY_KEY=
# CLOUDINARY_SECRET=

# -----------------------------------------------------------------------------
# Contact page
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=233241234567
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/233241234567
