# =============================================================================
# STEMNova Foundation — environment template
# Copy to .env.local and fill in real values:
#   cp .env.local.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# App / site
# -----------------------------------------------------------------------------
# Public site URL (sitemap, Open Graph, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# App environment: development | staging | production
NODE_ENV=development

# Random secret for signing sessions / cookies (generate a long random string)
APP_SECRET=

# -----------------------------------------------------------------------------
# Database (admin panel, forms, events, content)
# -----------------------------------------------------------------------------
# PostgreSQL connection string (Neon, Railway, local Postgres, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional: non-pooling URL for migrations (Neon often needs this)
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# -----------------------------------------------------------------------------
# Admin authentication
# -----------------------------------------------------------------------------
# NextAuth / Auth.js (or similar) for the admin panel
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Initial admin bootstrap (optional seed credentials)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Email (contact, volunteer, mentor, sponsor, fellowship, event registration)
# -----------------------------------------------------------------------------
# Provider: resend | nodemailer | sendgrid (choose one and fill matching keys)
EMAIL_PROVIDER=resend
EMAIL_FROM="STEMNova Foundation <noreply@stemnovafoundation.org>"
EMAIL_TO=info@stemnovafoundation.org

# Resend
RESEND_API_KEY=

# SMTP (if using nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# SendGrid (optional alternative)
# SENDGRID_API_KEY=

# -----------------------------------------------------------------------------
# Payments (donate page — currently mock until wired)
# -----------------------------------------------------------------------------
# Provider: paystack | flutterwave | stripe | mock
PAYMENT_PROVIDER=mock
NEXT_PUBLIC_PAYMENT_PROVIDER=mock

# Paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Flutterwave
FLUTTERWAVE_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Currency used by donation intents (e.g. GHS)
PAYMENT_CURRENCY=GHS

# -----------------------------------------------------------------------------
# Media / uploads (gallery, programmes, events, blog)
# -----------------------------------------------------------------------------
# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Or use a local / S3-compatible store later
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# -----------------------------------------------------------------------------
# Contact page
# -----------------------------------------------------------------------------
# Optional Google Maps embed URL for the contact page
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# WhatsApp (public button / contact)
NEXT_PUBLIC_WHATSAPP_NUMBER=233241234567
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/233241234567

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Rate limiting / abuse protection (Upstash Redis, etc.)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cron / background jobs (if used for digests, reminders)
# CRON_SECRET=
