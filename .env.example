# Dr. Wynnie's Foundation — Environment Variables
# Copy to .env.local and fill in values as integrations are configured.

# Public site URL (used for sitemap, Open Graph, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Maps embed URL for the contact page
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Payment providers are NOT configured by default.
# Donation forms use a mock service layer until a provider is wired up.
# NEXT_PUBLIC_PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=
