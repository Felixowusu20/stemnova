# Copy this file to .env.local:
#   cp .env.local.example .env.local
#
# Full backend variable list lives in .env.local.example

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Database (required for admin / forms backend)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
APP_SECRET=

# Email
EMAIL_PROVIDER=resend
EMAIL_FROM="STEMNova Foundation <noreply@stemnovafoundation.org>"
EMAIL_TO=info@stemnovafoundation.org
RESEND_API_KEY=

# Payments (mock until live)
PAYMENT_PROVIDER=mock
NEXT_PUBLIC_PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=GHS

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Contact extras
NEXT_PUBLIC_WHATSAPP_NUMBER=233241234567
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/233241234567
